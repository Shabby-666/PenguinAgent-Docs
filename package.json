{
  "name": "huhobot-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HuHoBotPenguin 文档站（VuePress 2 + vuepress-theme-plume）",
  "scripts": {
    "gen": "node scripts/gen-sponsor.mjs && node scripts/gen-adapters.mjs",
    "dev": "node scripts/gen-sponsor.mjs && node scripts/gen-adapters.mjs && vuepress dev",
    "docs:build": "node scripts/gen-sponsor.mjs && node scripts/gen-adapters.mjs && vuepress build",
    "docs:preview": "serve .vuepress/dist -l 4173",
    "build": "npm run docs:build",
    "preview": "npm run docs:preview"
  },
  "devDependencies": {
    "@vuepress/bundler-vite": "2.0.0-rc.31",
    "pinyin-pro": "^3.29.4",
    "serve": "^14.2.6",
    "typescript": "^5.9.3",
    "vue": "3.5.43",
    "vuepress": "2.0.0-rc.31",
    "vuepress-plugin-md-power": "1.0.0-rc.212",
    "vuepress-theme-plume": "1.0.0-rc.212"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
