# 文档站的依赖需要提升到顶层（shamefully-hoist）。
#
# 默认的 pnpm 非提升布局下，顶层 node_modules 只有 8 个直接依赖，
# minisearch / @vueuse/core / @iconify/vue 等间接依赖不在顶层，
# `vuepress dev` 的 Vite 预打包按裸模块名解析不到，页面会白屏：
#   Failed to resolve dependency: minisearch, present in client 'optimizeDeps.include'
#
# 生产构建（vuepress build）走 import 图解析，不受影响；
# 这里统一成提升布局，让 dev 与 build 行为一致。
shamefully-hoist=true
